{
  "name": "etiquetas-tienda-pro",
  "version": "4.2.0",
  "description": "Etiquetas Tienda Pro - inventario, promociones y etiquetas termicas",
  "main": "main.js",
  "author": "EL STOP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run preparar:claves && electron-builder --win nsis --x64 --publish never",
    "build:portable": "npm run preparar:claves && electron-builder --win portable --x64 --publish never",
    "build:signed": "powershell -NoProfile -File scripts/Compilar-Firmado.ps1",
    "preparar:claves": "node scripts/preparar-claves.js",
    "prestart": "npm run preparar:claves",
    "test": "node --test tests/license.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.etiquetastiendapro.app",
    "productName": "Etiquetas Tienda Pro",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "license-manager.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Etiquetas Tienda Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "opio30",
        "repo": "elstop",
        "releaseType": "release"
      }
    ],
    "artifactName": "Etiquetas-Tienda-Pro-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 EL STOP",
    "beforeBuild": "scripts/verificar-clave-build.js",
    "extraResources": [
      {
        "from": "resources/license-public.pem",
        "to": "license-public.pem"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opio30/elstop.git"
  },
  "homepage": "https://github.com/opio30/elstop",
  "bugs": {
    "url": "https://github.com/opio30/elstop/issues"
  },
  "private": true
}
